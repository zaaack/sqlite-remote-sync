{
  "name": "sqlite-remote-sync",
  "version": "0.1.1",
  "description": "Bidirectional, conflict-free SQLite sync over WebDAV / HTTP object storage, for kysely-sqlite-tools, web, React Native, Capacitor, Electron, Tauri and Node.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "keywords": [
    "sqlite",
    "sync",
    "webdav",
    "kysely",
    "crdt",
    "offline-first",
    "react-native",
    "capacitor",
    "tauri",
    "electron",
    "opfs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backends": {
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote/index.js"
    },
    "./backends/fs": {
      "types": "./dist/remote/fs.d.ts",
      "import": "./dist/remote/fs.js"
    },
    "./backends/mirror": {
      "types": "./dist/remote/mirror.d.ts",
      "import": "./dist/remote/mirror.js"
    },
    "./backends/files-sdk": {
      "types": "./dist/remote/files-sdk.d.ts",
      "import": "./dist/remote/files-sdk.js"
    },
    "./kysely": {
      "types": "./dist/kysely-plugin.d.ts",
      "import": "./dist/kysely-plugin.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "pnpm run build && pnpm --filter sqlite-remote-sync-demo run build",
    "dev:demo": "pnpm run build && pnpm --filter sqlite-remote-sync-demo run dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx --test test/webdav-e2e.test.ts",
    "qa": "pnpm run typecheck && pnpm run test && pnpm run build",
    "preversion": "pnpm test"
  },
  "peerDependencies": {
    "kysely": ">=0.29",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "kysely": "^0.29.9",
    "kysely-generic-sqlite": "^2.0.1",
    "react": "^19.3.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0",
    "webdav-server": "^2.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
